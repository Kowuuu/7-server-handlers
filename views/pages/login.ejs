<form id="loginForm" action="/api/login" method="POST" class="form-container">

    <!-- Email Field -->
    <div class="form-group">
        <label for="loginEmail">Email Address</label>
        <input
                type="email"
                id="loginEmail"
                name="email"
                placeholder="you@example.com"
                required
        />
    </div>

    <!-- Password Field -->
    <div class="form-group">
        <label for="loginPassword">Password</label>
        <input
                type="password"
                id="loginPassword"
                name="password"
                placeholder="Enter your password"
                required
        />
    </div>

    <!-- Submit Button -->
    <button type="submit" class="submit-btn">Log In</button>
</form>
