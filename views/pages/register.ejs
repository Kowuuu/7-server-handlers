
<form id="signupForm" action="/api/register" method="POST" class="form-container">

    <div class="form-group">
        <label for="name">Name</label>
        <input
                type="text"
                id="name"
                name="name"
                placeholder="you@example.com"
                required
        />
    </div>

    <!-- Email Field -->
    <div class="form-group">
        <label for="email">Email Address</label>
        <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                required
        />
    </div>

    <!-- Password Field -->
    <div class="form-group">
        <label for="password">Password</label>
        <input
                type="password"
                id="password"
                name="password"
                placeholder="Minimium 8 characters"
                minlength="8"
                required
        />
    </div>

    <!-- Repeat Password Field -->
    <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Repeat your password"
                minlength="8"
                required
        />
        <span id="passwordError" class="error-text" style="display: none; color: red;">
      Passwords do not match
    </span>
    </div>

    <!-- Terms & Rules Checkbox -->
    <div class="form-checkbox">
        <input
                type="checkbox"
                id="agreeRules"
                name="agreeRules"
                required
        />
        <label for="agreeRules"> I agree to the website terms and rules.</label>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="submit-btn">Create Account</button>
</form>


<script>
    // === 1. LOGIN FORM HANDLER ===
    const loginForm = document.getElementById('loginForm');
    if (loginForm) { // Guard check in case loginForm isn't on this exact page
        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = loginForm.email.value;
            const password = loginForm.password.value;

            try {
                const res = await fetch('/api/login', {
                    method: 'POST',
                    headers: {'content-type': 'application/json'},
                    body: JSON.stringify({email, password})
                });
                if (!res.ok) throw new Error("Failed to login");
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                }
            } catch (error) {
                console.error("Login client error:", error.message);
            }
        });
    }

    // === 2. SIGNUP/REGISTER FORM HANDLER ===
    const signupForm = document.getElementById('signupForm');
    if (signupForm) {
        signupForm.addEventListener('submit', async (e) => {
            e.preventDefault(); // Stop standard page redirection layout

            const name = signupForm.name.value;
            const email = signupForm.email.value;
            const password = signupForm.password.value;
            const confirmPassword = signupForm.confirmPassword.value;
            const errorText = document.getElementById('passwordError');

            // Client-Side Validation: Ensure passwords match before hitting your API
            if (password !== confirmPassword) {
                errorText.style.display = 'block';
                return; // Stop execution here!
            } else {
                errorText.style.display = 'none'; // Hide it if they fixed it
            }

            try {
                // Fire the registration payload to your Node backend
                const res = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, password })
                });

                const data = await res.json();

                if (!res.ok) {
                    // Handles any explicit validation array errors thrown by your backend
                    alert(Array.isArray(data) ? data.join('\n') : "Registration failed.");
                    throw new Error("Bad API input verification status");
                }

                // If your backend registers successfully and responds with { success: true }
                if (data.success) {
                    alert("Account created successfully!");
                    window.location.href = '/login'; // Redirect them to log in page
                }

            } catch (error) {
                console.error("Registration error:", error.message);
            }
        });
    }
</script>

